# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env

# ===== Обязательно =====
# URL подписки (или несколько через запятую). Также можно вставить
# share-ссылку напрямую (vless://..., vmess://..., trojan://..., ss://...)
SUBSCRIPTION_URL=https://your-subscription-url/sub

# ===== Веб-интерфейс и метрики =====
METRICS_HOST=0.0.0.0
METRICS_PORT=2112

# Защита дашборда и /metrics Basic Auth. Рекомендуется включить (true),
# если сервер смотрит в интернет без nginx/firewall перед ним.
METRICS_PROTECTED=false
METRICS_USERNAME=metricsUser
METRICS_PASSWORD=ChangeMeVeryHardPassword

# Публичная страница статуса без авторизации (без IP/портов серверов).
# Требует METRICS_PROTECTED=true.
WEB_PUBLIC=false

# Показывать IP:порт серверов в дашборде (выключи, если дашборд публичный)
WEB_SHOW_DETAILS=false

# ===== Проверка прокси =====
PROXY_CHECK_INTERVAL=300
PROXY_CHECK_METHOD=ip

# ===== Speedtest (фича этого форка) =====
# Замеряет download/upload через каждый прокси по очереди и показывает в дашборде
SPEEDTEST_ENABLED=false
SPEEDTEST_INTERVAL=240

# ===== Обновление подписки =====
SUBSCRIPTION_UPDATE=true
SUBSCRIPTION_UPDATE_INTERVAL=300

# ===== Прочее =====
LOG_LEVEL=info
